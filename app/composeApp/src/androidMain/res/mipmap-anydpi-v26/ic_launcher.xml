<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: without this, launchers shrink the whole legacy square inside their mask,
     which is why the app icon looked small and washed-out next to the PWA's. The foreground
     layer's text is sized for the mask's safe zone, so it presents as big as the PWA icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
